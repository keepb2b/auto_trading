# Copy to ".env" and replace placeholders. Do not commit real ".env" to git.
# See ENV_SETUP.md for where to place this file (dev / .exe / macOS .app).

# SMTP設定
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL_TO=

# 送信制限
DAILY_LIMIT=500

# API設定
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Supabase REST (CSV upload) — public project URL; same ref as DATABASE_URL / dashboard
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase REST (CSV upload). URL is derived from DATABASE_URL; you must add an API key from Dashboard → Settings → API.
# SUPABASE_SERVICE_ROLE_KEY=paste_service_role_secret_here
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Optional: same names your app may read elsewhere (safe to leave unset)
# SMTP_FROM=
# BACKEND_ENV_PATH=
# BACKEND_DOTENV=
# BACKEND_DIR=
# SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SCRAPED_COMPANIES_CSV=スクレイプ結果_企業.csv
# SCRAPER_PARALLEL_WORKERS=8
# SCRAPER_PER_DOMAIN_CONCURRENCY=2
# SCRAPER_CRAWL_MAX_PAGES=220
# SCRAPER_CRAWL_MAX_DEPTH=8
# SCRAPER_STOP_AFTER_CONTACT_PAGES=24
